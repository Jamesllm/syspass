# DRAGO Vault · copia este archivo como .env y completa los valores

# Conexión a PostgreSQL (usuario propio de la app, no el superusuario postgres)
DATABASE_URL=postgres://dragovault:CAMBIAR@localhost:5432/dragovault

# Llave maestra de cifrado: genera una con `npm run keygen`.
# Si se pierde, las contraseñas guardadas NO se pueden recuperar. Guarda una copia fuera del servidor.
# No la cambies después de guardar datos.
VAULT_KEY=

PORT=8080
# 127.0.0.1 si hay un proxy (nginx/IIS) delante; 0.0.0.0 para exponer directo en la red interna
HOST=127.0.0.1

# true cuando el sitio se sirve por HTTPS (recomendado)
SECURE_COOKIES=false
# true si hay un proxy inverso delante (para registrar la IP real en la auditoría)
TRUST_PROXY=false

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Solo si el frontend se sirve desde otro dominio o puerto (separado del backend)
# CORS_ORIGINS=https://vault.drago.pe

# single = una sola empresa (el login no pide código, registro cerrado) · multi = varias empresas (SaaS)
SYSPASS_MODE=multi
# Código de la empresa en modo single (vacío = se detecta si hay una sola)
# SYSPASS_ORG=drago
