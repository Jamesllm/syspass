{
  "name": "syspass",
  "private": true,
  "version": "1.4.0",
  "description": "SysPass · bóveda de credenciales multiempresa",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "admin:create": "npm run admin:create -w server --",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "platform:init": "npm run platform:init -w server --",
    "org:init": "npm run org:init -w server --"
  }
}
